{
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": ["Geist", "Inter", "ui-sans-serif", "system-ui", "sans-serif"], "$description": "Neutral grotesk — product-manual voice" },
      "mono": { "$value": ["Geist Mono", "JetBrains Mono", "ui-monospace", "monospace"], "$description": "Printed legends and display readouts" }
    },

    "weight": {
      "$type": "fontWeight",
      "regular":  { "$value": 400 },
      "medium":   { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold":     { "$value": 700 }
    },

    "size": {
      "$type": "dimension",
      "2xs":  { "$value": "0.6875rem", "$description": "Printed key legends" },
      "xs":   { "$value": "0.75rem" },
      "sm":   { "$value": "0.875rem" },
      "base": { "$value": "1rem" },
      "lg":   { "$value": "1.125rem" },
      "xl":   { "$value": "1.5rem" },
      "2xl":  { "$value": "2rem" },
      "3xl":  { "$value": "2.75rem" },
      "4xl":  { "$value": "3.5rem" }
    },

    "lineHeight": {
      "$type": "number",
      "tight":  { "$value": 1.05 },
      "snug":   { "$value": 1.3 },
      "normal": { "$value": 1.55 }
    },

    "letterSpacing": {
      "$type": "dimension",
      "tight":  { "$value": "-0.035em", "$description": "Display headings" },
      "normal": { "$value": "0em" },
      "wide":   { "$value": "0.08em",   "$description": "Uppercase mono legends" }
    }
  }
}
