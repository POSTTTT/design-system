{
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": ["Manrope", "ui-sans-serif", "system-ui", "-apple-system", "Segoe UI", "sans-serif"], "$description": "Clean geometric sans — crisp over blur" }
    },

    "weight": {
      "$type": "fontWeight",
      "regular":  { "$value": 400 },
      "medium":   { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold":     { "$value": 700 },
      "black":    { "$value": 800 }
    },

    "size": {
      "$type": "dimension",
      "xs":   { "$value": "0.75rem" },
      "sm":   { "$value": "0.875rem" },
      "base": { "$value": "1rem" },
      "lg":   { "$value": "1.125rem" },
      "xl":   { "$value": "1.375rem" },
      "2xl":  { "$value": "1.75rem" },
      "3xl":  { "$value": "2.25rem" },
      "4xl":  { "$value": "3.25rem" }
    },

    "lineHeight": {
      "$type": "number",
      "tight":  { "$value": 1.1 },
      "snug":   { "$value": 1.35 },
      "normal": { "$value": 1.6 }
    },

    "letterSpacing": {
      "$type": "dimension",
      "tight":  { "$value": "-0.025em", "$description": "Display headings" },
      "normal": { "$value": "0em" },
      "wide":   { "$value": "0.12em",   "$description": "Uppercase eyebrow labels" }
    }
  }
}
