{
  "font": {
    "family": {
      "$type": "fontFamily",
      "display": { "$value": ["Archivo", "Helvetica Neue", "Arial", "sans-serif"], "$description": "Headlines. Variable: wght 100-900, wdth 62-125" },
      "serif":   { "$value": ["Instrument Serif", "Georgia", "serif"], "$description": "Italic accent word inside headlines" },
      "sans":    { "$value": ["Inter", "ui-sans-serif", "system-ui", "sans-serif"], "$description": "Body copy" },
      "mono":    { "$value": ["Geist Mono", "ui-monospace", "Menlo", "monospace"], "$description": "Uppercase labels, indices, buttons" }
    },

    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium":  { "$value": 500 },
      "display": { "$value": 620, "$description": "Archivo headings" },
      "bold":    { "$value": 700 },
      "heavy":   { "$value": 750, "$description": "Extended wordmark" }
    },

    "size": {
      "$type": "dimension",
      "micro": { "$value": "0.5625rem", "$description": "Ruler numbers, 9px" },
      "label": { "$value": "0.6875rem", "$description": "Mono caps labels + buttons, 11px" },
      "sm":    { "$value": "0.875rem" },
      "base":  { "$value": "1rem" },
      "lead":  { "$value": "1.125rem", "$description": "Intro paragraphs, 18px" },
      "h3":    { "$value": "1.5rem",   "$description": "Cell title, 24px" },
      "h2":    { "$value": "2.25rem",  "$description": "Sub-headline, 36px" },
      "h1":    { "$value": "3.75rem",  "$description": "Section headline, 60px" },
      "xl":    { "$value": "4.5rem",   "$description": "Closing headline, 72px" },
      "mark":  { "$value": "6rem",     "$description": "Extended wordmark, 96px" }
    },

    "lineHeight": {
      "$type": "number",
      "display": { "$value": 1.02 },
      "heading": { "$value": 1.33 },
      "normal":  { "$value": 1.5 },
      "lead":    { "$value": 1.625 }
    },

    "letterSpacing": {
      "$type": "dimension",
      "tight":  { "$value": "-0.035em", "$description": "Display headlines" },
      "snug":   { "$value": "-0.02em",  "$description": "Cell titles" },
      "normal": { "$value": "0em" },
      "micro":  { "$value": "0.08em",   "$description": "9px ruler numbers" },
      "label":  { "$value": "0.15em",   "$description": "Mono uppercase labels" },
      "button": { "$value": "0.12em",   "$description": "Mono uppercase buttons" }
    },

    "stretch": {
      "$type": "dimension",
      "normal":   { "$value": "100%" },
      "extended": { "$value": "125%", "$description": "Archivo wdth axis for the wordmark + section index" }
    }
  }
}
